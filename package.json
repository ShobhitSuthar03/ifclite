{
  "name": "ifclite-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri desktop shell for IFClite that implements the NativeBridge host command contract.",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite --host 127.0.0.1 --port 43127",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview --host 127.0.0.1 --port 43127",
    "lint": "oxlint",
    "test": "vitest run",
    "tauri": "tauri",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --offline || cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@ifc-lite/data": "^3.5.0",
    "@ifc-lite/geometry": "^4.1.0",
    "@ifc-lite/lens": "^1.19.0",
    "@ifc-lite/mutations": "^1.27.0",
    "@ifc-lite/parser": "^4.0.0",
    "@ifc-lite/query": "^2.0.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
